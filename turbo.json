{
   "$schema": "https://turborepo.com/schema.json",
   "globalDependencies": ["**/.env.*local", "**/.env"],
   "ui": "tui",
   "tasks": {
      "db:generate": {
         "cache": false,
         "inputs": [
            "prisma/schema.prisma",
            "prisma/**/*.prisma",
            "prisma/migrations/**",
            ".env*",
            "$TURBO_DEFAULT$"
         ]
      },
      "build": {
         "dependsOn": ["^db:generate", "^build"],
         "outputs": [".next/**", "!.next/cache/**", "dist/**"],
         "inputs": [".env*", "$TURBO_DEFAULT$"],
         "env": [
            "NEXT_PUBLIC_*",
            "LANDING_ORIGIN",
            "DATABASE_URL",
            "BETTER_AUTH_SECRET",
            "RESEND_KEY",
            "GITHUB_CLIENT_ID",
            "GITHUB_CLIENT_SECRET",
            "ENCRYPTION_PRIVATE_KEY",
            "PORT",
            "NODE_ENV",
            "TRUST_PROXY",
            "COOKIE_SAMESITE",
            "EMAIL_FROM",
            "LOG_LEVEL",
            "DATA_DIR",
            "EMAIL_TRANSPORT",
            "SMTP_URL",
            "SUPPORT_EMAIL",
            "ALLOW_PRIVATE_ENDPOINTS",
            "MAX_UPLOAD_BYTES",
            "UPLOAD_PART_BYTES",
            "MAX_CONCURRENT_UPLOADS",
            "MAX_USER_UPLOADS",
            "UPLOAD_MEMORY_BUDGET_BYTES",
            "UPLOAD_IDLE_TIMEOUT_MS"
         ]
      },
      "dev": {
         "dependsOn": ["^db:generate"],
         "persistent": true,
         "cache": false,
         "env": [
            "NEXT_PUBLIC_*",
            "LANDING_ORIGIN",
            "DATABASE_URL",
            "BETTER_AUTH_SECRET",
            "RESEND_KEY",
            "GITHUB_CLIENT_ID",
            "GITHUB_CLIENT_SECRET",
            "ENCRYPTION_PRIVATE_KEY",
            "PORT",
            "NODE_ENV",
            "TRUST_PROXY",
            "COOKIE_SAMESITE",
            "EMAIL_FROM",
            "LOG_LEVEL",
            "DATA_DIR",
            "EMAIL_TRANSPORT",
            "SMTP_URL",
            "SUPPORT_EMAIL",
            "ALLOW_PRIVATE_ENDPOINTS",
            "MAX_UPLOAD_BYTES",
            "UPLOAD_PART_BYTES",
            "MAX_CONCURRENT_UPLOADS",
            "MAX_USER_UPLOADS",
            "UPLOAD_MEMORY_BUDGET_BYTES",
            "UPLOAD_IDLE_TIMEOUT_MS"
         ]
      },
      "lint": {
         "dependsOn": ["^db:generate"],
         "outputs": []
      },
      "check-types": {
         "dependsOn": ["^db:generate", "^build"],
         "outputs": []
      },
      "test": {
         "dependsOn": ["^db:generate"],
         "outputs": []
      }
   }
}
