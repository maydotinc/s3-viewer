{
   "$schema": "https://turborepo.com/schema.json",
   "globalDependencies": ["**/.env.*local", "**/.env"],
   "ui": "stream",
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "outputs": [".next/**", "!.next/cache/**", "dist/**"],
         "inputs": [".env*", "$TURBO_DEFAULT$"]
      },
      "dev": {
         "persistent": true,
         "cache": false
      }
   }
}
