generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String
  emailVerified Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  image         String?

  ownedServers    Server[]            @relation("ServerOwner")
  serverAccess    ServerAccess[]
  bucketAccess    BucketAccess[]
  sentInvitations PendingInvitation[] @relation("InvitationSender")
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Server {
  id                String   @id @default(cuid())
  name              String
  provider          Provider @default(Other)
  credentials       String
  allowedBuckets    String[] @default([])
  restrictedBuckets Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ownerId            String
  owner              User                @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  serverAccess       ServerAccess[]
  bucketAccess       BucketAccess[]
  pendingInvitations PendingInvitation[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("server")
}

model ServerAccess {
  id        String   @id @default(cuid())
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId])
  @@index([serverId])
  @@map("server_access")
}

model PendingInvitation {
  id        String   @id @default(cuid())
  email     String
  role      Role
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serverId    String
  server      Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  bucketAccess InvitationBucketAccess[]

  @@unique([email, serverId])
  @@index([invitedById])
  @@index([email])
  @@index([serverId])
  @@map("pending_invitation")
}

model BucketAccess {
  id         String   @id @default(cuid())
  bucketName String
  role       Role     @default(VIEWER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId, bucketName])
  @@index([userId, serverId])
  @@index([serverId])
  @@map("bucket_access")
}

model InvitationBucketAccess {
  id         String   @id @default(cuid())
  bucketName String
  role       Role     @default(VIEWER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invitationId String
  invitation   PendingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, bucketName])
  @@index([invitationId])
  @@map("invitation_bucket_access")
}

// no relations on purpose: an audit record must survive deletion of the user or
// server it refers to
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  serverId  String?
  target    String?
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
  @@index([actorId, createdAt])
  @@index([target])
  @@map("audit_log")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Provider {
  S3
  R2
  Other
}
