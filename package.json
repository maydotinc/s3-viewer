{
   "name": "s3-viewer",
   "version": "0.0.0",
   "private": true,
   "license": "MIT",
   "engines": {
      "node": ">=20.3"
   },
   "scripts": {
      "setup": "node scripts/setup.mjs",
      "dev": "node scripts/dev.mjs",
      "stop": "node scripts/stop.mjs",
      "build": "turbo run build",
      "lint": "turbo run lint",
      "check-types": "turbo run check-types",
      "test": "vitest run --passWithNoTests",
      "db:generate": "node scripts/db.mjs generate",
      "db:deploy": "node scripts/db.mjs deploy",
      "db:migrate": "node scripts/db.mjs migrate",
      "db:status": "node scripts/db.mjs status",
      "account:verify": "pnpm --filter api exec tsx verify-email.ts",
      "favicons": "tsx scripts/generate-favicons.ts",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
   },
   "packageManager": "pnpm@10.28.2",
   "devDependencies": {
      "prettier": "^3.5.3",
      "sharp": "^0.35.0",
      "turbo": "^2.10.12",
      "typescript": "catalog:",
      "vitest": "^3.2.4"
   }
}
