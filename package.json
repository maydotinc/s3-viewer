{
   "name": "s3-viewer",
   "version": "0.0.0",
   "private": true,
   "license": "MIT",
   "engines": {
      "node": ">=20"
   },
   "scripts": {
      "bootstrap": "bash scripts/setup-portless.sh",
      "dev": "turbo run dev",
      "build": "turbo run build",
      "lint": "turbo run lint",
      "check-types": "turbo run check-types",
      "test": "vitest run --passWithNoTests",
      "db:generate": "turbo run db:generate",
      "db:deploy": "pnpm --filter @s3-viewer/db db:deploy",
      "db:migrate": "pnpm --filter @s3-viewer/db db:migrate",
      "landing:assets": "tsx scripts/optimize-landing-assets.ts",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
   },
   "packageManager": "pnpm@10.28.2",
   "devDependencies": {
      "prettier": "^3.5.3",
      "sharp": "^0.35.0",
      "turbo": "^2.5.4",
      "typescript": "catalog:",
      "vitest": "^3.2.4"
   }
}
