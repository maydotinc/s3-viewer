# Public origin of this web app: auth redirects, canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://web.localhost

# Public origin of the API.
NEXT_PUBLIC_API_URL=https://api.localhost

# RSA public key (4096-bit) that encrypts S3 credentials in the browser before they reach the API.
NEXT_PUBLIC_ENCRYPTION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."

# Optional

# Sign-in methods shown on the login page. Mirror the API's EMAIL_LOGIN_ENABLED /
# PASSWORD_LOGIN_ENABLED: on unless exactly `false`.
NEXT_PUBLIC_EMAIL_LOGIN_ENABLED=
NEXT_PUBLIC_PASSWORD_LOGIN_ENABLED=

# Exactly `true` shows "Continue with GitHub"; the API needs a GitHub OAuth app too.
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false

# Hidden origin of the landing deployment, proxied for the marketing routes; unset ⇒ "/" redirects to /dashboard.
LANDING_ORIGIN=https://landing.localhost
