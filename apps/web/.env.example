# public origin of this web app: auth redirects, canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# public origin of the API. the encryption public key and whether GitHub login is
# available are fetched from it at runtime (GET /config), so neither needs a variable here.
NEXT_PUBLIC_API_URL=http://localhost:5001

# optional

# hidden origin of the landing deployment, proxied for the marketing routes; unset ⇒ "/" redirects to /dashboard.
#LANDING_ORIGIN=http://localhost:3001
