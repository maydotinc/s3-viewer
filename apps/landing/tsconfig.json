{
   "extends": "@s3-viewer/ts-config/nextjs",
   "compilerOptions": {
      "baseUrl": ".",
      "paths": {
         "@/*": ["./*"]
      }
   },
   "include": [
      "**/*.ts",
      "**/*.tsx",
      "next-env.d.ts",
      "next.config.ts",
      ".next/types/**/*.ts"
   ],
   "exclude": ["node_modules"]
}
