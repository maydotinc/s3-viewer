# Public origin of the web app, which proxies this site: canonical, OG and absolute links.
NEXT_PUBLIC_SITE_URL=https://web.localhost

# Required in production (build fails without it). This deployment's own public origin —
# landing is meant to be reverse-proxied behind the web app, so pages are served from the
# web app's domain but /_next/* and other static assets must still resolve back here.
# Set this to landing's own URL even if you're running it standalone with no proxy in front.
NEXT_PUBLIC_ASSET_PREFIX=
