# public origin of the web app, which proxies this site: canonical, OG and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# optional

# leave this unset unless you know you need it. by default this site serves its own
# /_next/* assets under the path /landing-assets, which the web app proxies straight back
# here, so the browser only ever talks to the web app's domain and this deployment needs
# no public hostname of its own.
# set it to this deployment's own public origin (e.g. https://landing.example.com) only
# when the assets are meant to be fetched from here directly. Inlined at build time, so it
# must be set before `pnpm build` / the Docker build, not just at runtime.
#NEXT_PUBLIC_ASSET_PREFIX=
