      "@prisma/client": "catalog:",
      "@react-email/components": "catalog:",
      "@react-email/render": "catalog:",
      "@s3-viewer/auth": "workspace:*",
      "@s3-viewer/db": "workspace:*",
      "@s3-viewer/email": "workspace:*",
      "@s3-viewer/permissions": "workspace:*",
      "@s3-viewer/shared": "workspace:*",
      "archiver": "^8.0.0",
      "better-auth": "catalog:",
      "compression": "^1.8.2",
      "cors": "^2.8.5",
      "dotenv": "^16.5.0",
      "express": "^5.3.0",
      "express-rate-limit": "^8.7.0",
      "helmet": "^8.3.0",
      "nodemailer": "catalog:",
