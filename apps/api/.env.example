# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:pass@localhost:5432/s3viewer"

# Secret that signs Better Auth sessions and tokens (`openssl rand -base64 32`).
# Optional when DATA_DIR is set: one is generated on first boot and persisted there.
BETTER_AUTH_SECRET=your_secret_here

# RSA private key (4096-bit) that decrypts stored S3 credentials; the public half is
# derived from it and served on GET /config. Optional when DATA_DIR is set.
# `pnpm run setup` and the DATA_DIR generator both emit PKCS#8 (BEGIN PRIVATE KEY);
# a PKCS#1 key (BEGIN RSA PRIVATE KEY) is accepted too.
ENCRYPTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."

# Writable directory where generated secrets are persisted, so a container comes back
# with the same keys. Unset in development; the Docker image sets it to /data.
DATA_DIR=

# Public origin of the web app: CORS, the Origin check, trusted origins and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public origin of this API: Better Auth base URL and OAuth callbacks.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Email (optional; see below)

# Which mail transport sends auth and invite email: `none`, `resend` or `smtp`.
# Unset ⇒ inferred: `resend` when RESEND_KEY is set, else `smtp` when SMTP_URL
# is set, else `none`.
EMAIL_TRANSPORT=

# SMTP connection string, e.g. smtp://user:pass@mail.example.com:587 or
# smtps://... for implicit TLS. Required in every environment when
# EMAIL_TRANSPORT=smtp — a transport you selected on purpose is a
# misconfiguration when it has nowhere to connect, so the API refuses to
# start. Ignored by the other transports.
SMTP_URL=

# Resend API key. Required when EMAIL_TRANSPORT=resend. With EMAIL_TRANSPORT=none
# nothing is sent: sign-in still works, but email verification, password reset and
# invites are unavailable, and in development the full message is printed to the log
# so you can copy the link.
RESEND_KEY=

# Sender for auth and invite emails, e.g. "S3 Viewer <hello@yourdomain.com>".
# Required in production — there is no default; self-hosters must not send
# mail claiming to be from May Inc. Unset in development ⇒ falls back to a
# placeholder sender.
EMAIL_FROM=

# Optional

# Contact shown to admins who hit the pending-invite cap; unset ⇒ omitted from the message.
SUPPORT_EMAIL=

# GitHub OAuth app id; set together with the secret, or leave both unset.
GITHUB_CLIENT_ID=

# GitHub OAuth app secret; set together with the id, or leave both unset.
GITHUB_CLIENT_SECRET=

# Exactly `true` lets S3 endpoints resolve to private or loopback addresses (a MinIO on
# your LAN, the local demo bucket). Default false, which is the SSRF-safe setting.
ALLOW_PRIVATE_ENDPOINTS=

# Port the API listens on (default 5001).
PORT=5001

# Express trust-proxy setting (default `loopback`); behind a load balancer use the hop count, e.g. 1.
# Every per-IP rate limit reads req.ip, which Express derives from this setting. Only set this to
# `true` or a hop count if the proxy in front of the API strips any client-supplied X-Forwarded-For
# before adding its own — otherwise a client can forge the header and spoof its way past every limit.
TRUST_PROXY=loopback

# `lax` (default) or `none`. Set `none` only when NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_API_URL
# are different *sites* (e.g. two *.onrender.com hostnames), where a Lax cookie is never sent;
# requires an https:// NEXT_PUBLIC_API_URL. Same registrable domain (app.x.com / api.x.com) is
# same-site and keeps `lax`.
COOKIE_SAMESITE=

# Largest upload body in bytes; unset ⇒ 5368709120 (5 GiB).
MAX_UPLOAD_BYTES=

# Multipart upload part size in bytes; unset ⇒ 26214400 (25 MiB). Min 5242880 (5 MiB, S3's
# minimum), max 5368709120 (5 GiB, S3's maximum). Uploads with a known Content-Length use a
# larger part size automatically when needed to stay under S3's 10,000-part cap.
UPLOAD_PART_BYTES=

# debug | info | warn | error (default `warn` in production, `debug` otherwise).
LOG_LEVEL=
