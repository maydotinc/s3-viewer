# PostgreSQL connection string used by Prisma.
# connection_limit=20 and pool_timeout=20 are each added when the URL does not
# set them; put either in the query string to override it.
DATABASE_URL="postgresql://user:pass@localhost:5432/s3viewer"

# secret that signs Better Auth sessions and tokens (`openssl rand -base64 32`).
# optional when DATA_DIR is set: one is generated on first boot and persisted there.
BETTER_AUTH_SECRET=your_secret_here

# RSA private key (4096-bit) that decrypts stored S3 credentials; the public half is
# derived from it and served on GET /config. optional when DATA_DIR is set.
# `pnpm run setup` and the DATA_DIR generator both emit PKCS#8 (BEGIN PRIVATE KEY);
# a PKCS#1 key (BEGIN RSA PRIVATE KEY) is accepted too.
ENCRYPTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."

# writable directory where generated secrets are persisted, so a container comes back
# with the same keys. unset in development; the Docker image sets it to /data.
DATA_DIR=

# public origin of the web app: CORS, the Origin check, trusted origins and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# public origin of this API: Better Auth base URL and OAuth callbacks.
NEXT_PUBLIC_API_URL=http://localhost:5001

# email (optional; see below)

# which mail transport sends auth and invite email: `none`, `resend` or `smtp`.
# unset ⇒ inferred: `resend` when RESEND_KEY is set, else `smtp` when SMTP_URL
# is set, else `none`.
EMAIL_TRANSPORT=

# SMTP connection string, e.g. smtp://user:pass@mail.example.com:587 or
# smtps://... for implicit TLS. smtp:// with a username and password requires
# STARTTLS; append ?requireTLS=false for a relay without TLS. required in
# every environment when EMAIL_TRANSPORT=smtp — a transport you selected on
# purpose is a misconfiguration when it has nowhere to connect, so the API
# refuses to start. ignored by the other transports.
SMTP_URL=

# Resend API key. required when EMAIL_TRANSPORT=resend. with EMAIL_TRANSPORT=none
# nothing is sent: sign-in still works, but emailed verification, password reset
# and invites are unavailable (operators can verify accounts using the console
# command), and in development the full message is printed to the log so you
# can copy the link.
RESEND_KEY=

# sender for auth and invite emails, e.g. "S3 Viewer <hello@yourdomain.com>".
# required in production whenever a transport delivers mail (resend or smtp);
# there is no default sender. unset in development ⇒ a placeholder sender.
EMAIL_FROM=

# optional

# contact shown to admins who hit the pending-invite cap; unset ⇒ omitted from the message.
SUPPORT_EMAIL=

# GitHub OAuth app id; set together with the secret, or leave both unset.
GITHUB_CLIENT_ID=

# GitHub OAuth app secret; set together with the id, or leave both unset.
GITHUB_CLIENT_SECRET=

# exactly `true` lets S3 endpoints resolve to private or loopback addresses (a MinIO on
# your LAN, the local demo bucket). default false, which is the SSRF-safe setting.
ALLOW_PRIVATE_ENDPOINTS=

# the API records a fingerprint of ENCRYPTION_PRIVATE_KEY in the database and refuses
# to boot with a different one. exactly `true` for one boot records the new key
# instead; every stored credential becomes unreadable.
ACCEPT_NEW_ENCRYPTION_KEY=

# dedicated key for the audit log's hash chain, independent of BETTER_AUTH_SECRET.
# unset: a fresh install generates and persists one into DATA_DIR the same way as the
# two secrets above; an install that already has audit history keeps deriving its chain
# key from BETTER_AUTH_SECRET, so existing rows keep verifying. set it by hand only to
# carry a generated key across a reinstall (`openssl rand -base64 32`).
AUDIT_CHAIN_KEY=

# the API records a fingerprint of the active audit chain key and refuses to boot with a
# different one — including one derived from a rotated BETTER_AUTH_SECRET while
# AUDIT_CHAIN_KEY is still unset. exactly `true` for one boot records the new key instead;
# audit rows written before now can no longer be verified (they stay readable).
ACCEPT_NEW_AUDIT_CHAIN_KEY=

# port the API listens on (default 5001).
PORT=5001

# Express trust-proxy setting (default `loopback`); behind a load balancer use the hop count, e.g. 1.
# every per-IP rate limit reads req.ip, which Express derives from this setting. only set this to
# `true` or a hop count if the proxy in front of the API strips any client-supplied X-Forwarded-For
# before adding its own — otherwise a client can forge the header and spoof its way past every limit.
TRUST_PROXY=loopback

# `lax` (default) or `none`. set `none` only when NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_API_URL
# are different *sites* (e.g. a platform that gives each service its own public-suffix hostname),
# where a Lax cookie is never sent; requires an https:// NEXT_PUBLIC_API_URL. same registrable
# domain (app.x.com / api.x.com) is same-site and keeps `lax`.
COOKIE_SAMESITE=

# `postgres` (default) or `memory`. shares the sign-in, sign-up, connect and
# invite rate limits — the per-address and per-account throttles included —
# across every API replica; the high-volume limiters always stay per replica.
# set `memory` only for a single-replica deployment: behind a load balancer
# with more than one replica, `memory` gives each replica its own budget for
# exactly the limits meant to slow down credential stuffing and enumeration.
RATE_LIMIT_STORE=

# largest upload body in bytes; unset ⇒ 5368709120 (5 GiB).
MAX_UPLOAD_BYTES=

# multipart upload part size in bytes; unset ⇒ 5242880 (5 MiB). min 5242880 (5 MiB, S3's
# minimum), max 5368709120 (5 GiB, S3's maximum). uploads with a known Content-Length use a
# larger part size automatically when needed to stay under S3's 10,000-part cap.
UPLOAD_PART_BYTES=

# per API process: maximum active uploads (default 6), maximum per user (default 3).
# once half the active uploads are taken, one client address may hold at most
# MAX_IP_UPLOADS of them (default 2); before that it may hold the per-user maximum.
MAX_CONCURRENT_UPLOADS=
MAX_USER_UPLOADS=
MAX_IP_UPLOADS=

# shared upload buffer reservation budget; default 268435456 (256 MiB).
# must hold more than four buffers of the largest part size an upload can use:
# UPLOAD_PART_BYTES, or the bigger part (up to 64 MiB) that an upload of
# MAX_UPLOAD_BYTES needs to fit S3's 10,000-part cap. this is not total process
# memory: leave headroom for Node, TLS and other requests when setting the
# container limit.
UPLOAD_MEMORY_BUDGET_BYTES=

# abort an upload that stops receiving data; default 120000 (two minutes).
UPLOAD_IDLE_TIMEOUT_MS=

# longest an upload or zip download may hold its slot, in milliseconds; default
# 7200000 (two hours). an upload's own deadline scales with its declared size
# (at least ten minutes) and never exceeds this.
UPLOAD_SLOT_MAX_MS=

# ceilings for "Download as zip": how many objects one archive may contain
# (default 10000) and their combined size in bytes (default 10737418240, 10 GiB).
# both are checked from the listing before anything is streamed.
MAX_ARCHIVE_OBJECTS=
MAX_ARCHIVE_BYTES=

# who can create a new account: `open` (default), `domains`, `invite` or `closed`.
# `domains` needs ALLOWED_EMAIL_DOMAINS below and is inferred when that is set without
# this; it and `invite` also always admit a live invited address. `closed` admits nobody.
# none of them affect sign-in.
SIGNUP_MODE=

# comma/whitespace-separated allowlist for SIGNUP_MODE=domains, e.g. acme.com, acme.dev.
# a leading @ is optional. empty with SIGNUP_MODE=domains is a boot error.
ALLOWED_EMAIL_DOMAINS=

# positive value prunes audit log rows older than this many days, hourly; unset ⇒ 0,
# which keeps them forever. a server's own retentionDays overrides this when set.
AUDIT_RETENTION_DAYS=365

# floor, in days, for every server's audit retention: shorter values are refused or raised
# to this, and the log of a deleted server is kept this long. unset ⇒ 90.
AUDIT_RETENTION_MIN_DAYS=

# unverified accounts that own, joined and invited nothing are deleted, hourly, once
# they are this many days old; unset ⇒ 7, and 0 keeps them forever.
UNVERIFIED_ACCOUNT_TTL_DAYS=

# HTTP keep-alive timeout in milliseconds; unset ⇒ 65000. headersTimeout is set to this
# plus 5 seconds. set it above your load balancer's own idle timeout, or a keep-alive
# socket Node has just closed causes intermittent 502s.
KEEP_ALIVE_TIMEOUT_MS=

# max concurrent sockets the outbound S3 agent keeps open, per host (unset ⇒ 100) and
# in total (unset ⇒ 1000).
S3_MAX_SOCKETS_PER_HOST=
S3_MAX_TOTAL_SOCKETS=

# upstream S3 requests allowed per connected server per API process per minute;
# unset ⇒ 12000. past it, storage routes for that server answer 429 for a minute.
# with N replicas the real ceiling is N × this.
S3_REQUESTS_PER_MINUTE=

# upstream S3 requests one server, and one account across all its servers, may have
# waiting on storage at once per API process; unset ⇒ 32 and 64. past either, storage
# routes answer 429. keep the per-account value well under S3_MAX_TOTAL_SOCKETS.
S3_MAX_INFLIGHT_PER_SERVER=
S3_MAX_INFLIGHT_PER_USER=

# milliseconds an upstream S3 request may wait for storage to start answering;
# unset ⇒ 1200000 (20 minutes). it must outlast the slowest legitimate copy or part upload.
S3_REQUEST_TIMEOUT_MS=

# whether the Docker entrypoint runs `prisma migrate deploy` on boot; unset ⇒ true.
# set `false` on every API replica but one when running more than one, so they do not
# race the same migration.
RUN_MIGRATIONS=

# debug | info | warn | error (default `warn` in production, `debug` otherwise).
LOG_LEVEL=

# `true` turns on Prisma's query log, which prints bound parameters; off otherwise.
PRISMA_LOG_QUERIES=
