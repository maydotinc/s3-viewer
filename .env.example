# settings for the self-hosting stack. only docker compose reads this file;
# `pnpm dev` runs from the app .env files that `pnpm run setup` writes instead.
#
# copy it to .env and edit. every value has a working default, so
# `docker compose up -d` serves http://localhost:3000 with no .env at all.
# images are built from this checkout: the first `up -d` builds them, and
# `docker compose up -d --build` rebuilds after a `git pull` or a
# `git checkout vX.Y.Z`.
#
# leave an optional line commented out rather than blank. an empty value is
# still a value, and the API reads it as one. apps/api/.env.example documents
# each API variable in full: meaning, accepted values and defaults.

## public origins

# what people type in the browser.
SITE_URL=http://localhost:3000
# must be reachable from the browser, not only from the web container.
API_URL=http://localhost:5001

## bundled postgres

# change it before the first start; the database user keeps its first password.
POSTGRES_PASSWORD=s3viewer

## landing site (docker compose --profile landing up -d)

# origin of the landing container. only the web container talks to it, and it
# proxies the landing assets too, so it never needs a public hostname. unset,
# `/` opens the dashboard.
#LANDING_ORIGIN=http://landing:3001

## Caddy (docker compose -f docker-compose.yml -f docker-compose.proxy.yml --profile proxy up -d)

# hostnames Caddy serves the web app and the API on. point both at this server.
#SITE_HOSTNAME=s3.example.com
#API_HOSTNAME=api.example.com
# proxy hops the API trusts for client IPs. unset ⇒ `loopback`, or `1` with
# docker-compose.proxy.yml. set it only for a proxy of your own, or for a
# second hop such as a CDN in front of Caddy, which also needs
# `trusted_proxies` in deploy/Caddyfile.
#TRUST_PROXY=1

## secrets

# unset, the API generates these on first boot and keeps them in its /data
# volume. set them only to move an existing install onto this stack, so that
# sessions stay valid and stored S3 credentials stay decryptable.
#BETTER_AUTH_SECRET=
# one line, in double quotes, with `\n` where the PEM's newlines were; compose
# expands escapes only inside quotes. check with `docker compose config`.
#ENCRYPTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIJQ...\n-----END PRIVATE KEY-----\n"
# carry a generated audit chain key across a reinstall (`openssl rand -base64 32`).
#AUDIT_CHAIN_KEY=
# `true` for one boot accepts a changed encryption key; every stored credential is lost.
#ACCEPT_NEW_ENCRYPTION_KEY=true
# `true` for one boot accepts a changed audit chain key; older audit rows stop verifying.
#ACCEPT_NEW_AUDIT_CHAIN_KEY=true

## accounts

# who can create an account: `open` | `domains` | `invite` | `closed`.
#SIGNUP_MODE=open
# allowlist for SIGNUP_MODE=domains, e.g. acme.com, acme.dev.
#ALLOWED_EMAIL_DOMAINS=
# delete unverified accounts with no servers or invites after this many days; 0 keeps them.
#UNVERIFIED_ACCOUNT_TTL_DAYS=7
# GitHub OAuth app; set both or neither.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
# `none` when the web app and the API are on different sites; needs an https:// API_URL.
#COOKIE_SAMESITE=none

## email

# `none` | `resend` | `smtp`. unset infers from RESEND_KEY / SMTP_URL, else none.
#EMAIL_TRANSPORT=smtp
#RESEND_KEY=re_...
# smtp:// with STARTTLS, smtps:// for implicit TLS.
#SMTP_URL=smtp://user:pass@mail.example.com:587
#EMAIL_FROM=S3 Viewer <no-reply@example.com>
# contact shown to admins who hit the pending-invite cap.
#SUPPORT_EMAIL=support@example.com
# invite emails the whole instance may send per day.
#INVITE_EMAILS_PER_DAY=500

## storage

# `true` allows S3 endpoints on private or loopback addresses (a LAN MinIO).
#ALLOW_PRIVATE_ENDPOINTS=true
# milliseconds an upstream S3 request may wait for storage to start answering.
#S3_REQUEST_TIMEOUT_MS=1200000
# upstream S3 requests allowed per connected server per API process per minute.
#S3_REQUESTS_PER_MINUTE=12000
# upstream S3 requests one server, and one account across its servers, may have in flight at once.
#S3_MAX_INFLIGHT_PER_SERVER=32
#S3_MAX_INFLIGHT_PER_USER=64
# max concurrent sockets each connected server's outbound S3 agent keeps open per host.
#S3_MAX_SOCKETS_PER_HOST=100
# per-process ceiling on storage calls in flight across all servers, and each server's agent socket total.
#S3_MAX_TOTAL_SOCKETS=1000

## uploads and zip downloads

# largest upload body in bytes.
#MAX_UPLOAD_BYTES=5368709120
# multipart part size in bytes.
#UPLOAD_PART_BYTES=5242880
# per API process: active upload cap, per-user cap, per-address cap once uploads are busy.
#MAX_CONCURRENT_UPLOADS=6
#MAX_USER_UPLOADS=3
#MAX_IP_UPLOADS=2
# reserved upload buffer budget in bytes; leave the container headroom for Node and TLS.
#UPLOAD_MEMORY_BUDGET_BYTES=268435456
# abort an upload that stops receiving data for this many milliseconds.
#UPLOAD_IDLE_TIMEOUT_MS=120000
# longest an upload or zip download may hold its slot, in milliseconds.
#UPLOAD_SLOT_MAX_MS=7200000
# ceilings for "Download as zip": object count and combined bytes per archive.
#MAX_ARCHIVE_OBJECTS=10000
#MAX_ARCHIVE_BYTES=10737418240

## audit log

# prune audit log rows older than this many days, 0..3650; 0 keeps them forever.
#AUDIT_RETENTION_DAYS=365
# shortest retention a server owner may pick, 1..3650; rows of deleted servers are kept this long too.
#AUDIT_RETENTION_MIN_DAYS=90

## more than one API replica

# `false` (or 0/no/off) skips `prisma migrate deploy` on boot; set it on every replica but one.
#RUN_MIGRATIONS=true
# `postgres` shares auth rate limits across replicas; `memory` for a single replica.
#RATE_LIMIT_STORE=postgres
# HTTP keep-alive timeout in milliseconds; set it above your load balancer's idle timeout.
#KEEP_ALIVE_TIMEOUT_MS=65000

## logging

# debug | info | warn | error; anything else refuses to boot.
#LOG_LEVEL=warn
# `true` (or 1/yes/on) prints every Prisma statement with its bound parameters; development only.
#PRISMA_LOG_QUERIES=true
