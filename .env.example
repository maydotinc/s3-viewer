# root .env — read only by docker compose (the self-hosting stack).
# contributors do not need this file: `pnpm run setup` writes apps/api/.env,
# apps/web/.env and, with the landing site, apps/landing/.env; `pnpm dev` runs
# from those.
#
# copy to .env and edit. every value below has a working default, so
# `docker compose up -d` serves http://localhost:3000 with no .env at all.
#
# every image is built from this checkout: `docker compose up -d` builds them
# the first time, and `docker compose up -d --build` rebuilds after a `git pull`
# or a `git checkout vX.Y.Z`.
#
# optional profiles:
#   docker compose --profile landing up -d
#     marketing site; also set LANDING_ORIGIN below.
#   docker compose -f docker-compose.yml -f docker-compose.proxy.yml --profile proxy up -d
#     Caddy TLS edge; needs SITE_HOSTNAME and API_HOSTNAME. always run
#     with the override file: it sets TRUST_PROXY=1 on the API, without which
#     every per-IP rate limit collapses onto Caddy's container address.

# public origin of the web app — what people type in the browser.
SITE_URL=http://localhost:3000
# public origin of the API — must be reachable from the browser, not just from web.
API_URL=http://localhost:5001
# password for the bundled postgres container.
POSTGRES_PASSWORD=s3viewer

# everything below is optional. leave a line commented out rather than blank —
# an empty value is still a value, and services read it as one.

# origin of the landing container; commented out means `/` goes to the dashboard.
# uncomment this exact line when you run `--profile landing`: only the web container
# talks to it, and it proxies landing's assets too, so it never needs to be public.
#LANDING_ORIGIN=http://landing:3001
# hostname Caddy serves the web app on (proxy profile).
#SITE_HOSTNAME=s3.example.com
# hostname Caddy serves the API on (proxy profile).
#API_HOSTNAME=api.s3.example.com

# hops the API trusts for client IPs. unset ⇒ `loopback`, or `1` when you run
# with docker-compose.proxy.yml. uncommenting this overrides both, so only set
# it for a proxy of your own, or for a second hop (a CDN in front of Caddy —
# which also needs `trusted_proxies` in deploy/Caddyfile).
#TRUST_PROXY=1

# secrets for migrating an existing install onto this stack. unset (the normal
# case) the API generates both on first boot and keeps them in its /data volume.
# set the old values here instead and sessions stay valid and already-stored S3
# credentials stay decryptable. the PEM has to be one line, in double quotes,
# with `\n` where its newlines were — compose expands escapes only inside
# quotes. check it with `docker compose config`.
#BETTER_AUTH_SECRET=
#ENCRYPTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIJQ...\n-----END PRIVATE KEY-----\n"
# carry a generated audit chain key across a reinstall the same way (`openssl rand -base64 32`).
#AUDIT_CHAIN_KEY=
# `true` for one boot accepts a changed encryption key; every stored credential is lost.
#ACCEPT_NEW_ENCRYPTION_KEY=true
# `true` for one boot accepts a changed audit chain key; older audit rows stop verifying.
#ACCEPT_NEW_AUDIT_CHAIN_KEY=true

# the rest pass straight through to the API container. apps/api/.env.example
# documents each one in full (meaning, accepted values and defaults).
# who can create an account: `open` | `domains` | `invite` | `closed`.
#SIGNUP_MODE=open
# allowlist for SIGNUP_MODE=domains, e.g. acme.com, acme.dev.
#ALLOWED_EMAIL_DOMAINS=
# `none` when the web app and the API are on different sites; needs an https:// API_URL.
#COOKIE_SAMESITE=none
# `none` | `resend` | `smtp`. unset infers from RESEND_KEY / SMTP_URL, else none.
#EMAIL_TRANSPORT=smtp
# Resend API key.
#RESEND_KEY=re_...
# SMTP connection string (smtp:// with STARTTLS, smtps:// for implicit TLS).
#SMTP_URL=smtp://user:pass@mail.example.com:587
# from address on outgoing email.
#EMAIL_FROM=S3 Viewer <no-reply@example.com>
# contact shown to admins who hit the pending-invite cap.
#SUPPORT_EMAIL=support@example.com
# GitHub OAuth app client id; set both id and secret or neither.
#GITHUB_CLIENT_ID=
# GitHub OAuth app client secret.
#GITHUB_CLIENT_SECRET=
# `true` allows S3 endpoints on private/loopback addresses (a LAN MinIO).
#ALLOW_PRIVATE_ENDPOINTS=true
# largest upload body in bytes.
#MAX_UPLOAD_BYTES=5368709120
# multipart part size in bytes.
#UPLOAD_PART_BYTES=5242880
# per API process: active upload cap, per-user cap, per-address cap once uploads
# are busy, and reserved buffer budget.
#MAX_CONCURRENT_UPLOADS=6
#MAX_USER_UPLOADS=3
#MAX_IP_UPLOADS=2
#UPLOAD_MEMORY_BUDGET_BYTES=268435456
# abort an upload that stops receiving data for this many milliseconds.
#UPLOAD_IDLE_TIMEOUT_MS=120000
# longest an upload or zip download may hold its slot, in milliseconds.
#UPLOAD_SLOT_MAX_MS=7200000
# ceilings for "Download as zip": object count and combined bytes per archive.
#MAX_ARCHIVE_OBJECTS=10000
#MAX_ARCHIVE_BYTES=10737418240
# `false` skips `prisma migrate deploy` on boot; set it on every API replica but one.
#RUN_MIGRATIONS=true
# `postgres` shares auth rate limits across replicas; `memory` for a single replica.
#RATE_LIMIT_STORE=postgres
# prune audit log rows older than this many days; 0 keeps them forever.
#AUDIT_RETENTION_DAYS=365
# shortest retention a server owner may pick; rows of deleted servers are kept this long too.
#AUDIT_RETENTION_MIN_DAYS=90
# delete unverified accounts with no servers or invites after this many days; 0 keeps them.
#UNVERIFIED_ACCOUNT_TTL_DAYS=7
# HTTP keep-alive timeout in milliseconds; set above your load balancer's idle timeout.
#KEEP_ALIVE_TIMEOUT_MS=65000
# max concurrent sockets the outbound S3 agent keeps open, per host and in total.
#S3_MAX_SOCKETS_PER_HOST=100
#S3_MAX_TOTAL_SOCKETS=1000
# upstream S3 requests allowed per connected server per API process per minute.
#S3_REQUESTS_PER_MINUTE=12000
# upstream S3 requests one server, and one account across its servers, may have in flight at once.
#S3_MAX_INFLIGHT_PER_SERVER=32
#S3_MAX_INFLIGHT_PER_USER=64
# milliseconds an upstream S3 request may wait for storage to start answering.
#S3_REQUEST_TIMEOUT_MS=1200000
# debug | info | warn | error.
#LOG_LEVEL=warn
# `true` prints every Prisma statement with its bound parameters; development only.
#PRISMA_LOG_QUERIES=true
